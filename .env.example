# Copy to .env.local and uncomment the settings needed for your machine.
# Generate a unique VISCANE_SECRET_KEY; never commit the real value.
# VISCANE_SECRET_KEY=replace-with-a-random-secret
# DJANGO_DEBUG=true
# Include the Android emulator alias; add your PC LAN IP for Wi-Fi phone testing.
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2
# DATABASE_URL=sqlite:///.local/development.sqlite3
# SCAN_PREDICT_ENDPOINT=http://127.0.0.1:8000/predict
# SCAN_PREDICT_TIMEOUT_SECONDS=5
# DEEPSEEK_API_KEY=
# VISCANE_FARMER_ONLY=true
# DJANGO_CSRF_TRUSTED_ORIGINS=https://farmers.example.org
# DJANGO_TRUST_PROXY=false
# VISCANE_PRIVATE_UPLOAD_ROOT=/persistent/private-upload-storage
